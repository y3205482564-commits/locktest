# 本地开发环境
NODE_ENV=development

# 资源公共路径,需要以 /开头和结尾
VITE_PUBLIC_PATH = /

# 本地开发代理，可以解决跨域及多地址代理
# 如果接口地址匹配到，则会转发到http://localhost:3000，防止本地出现跨域问题
# 可以有多个，注意多个不能换行，否则代理将会失效
# VITE_PROXY = [["/dev-api","http://localhost:48080/admin-api"]]
# VITE_PROXY=[["/api","http://vben.xingyuv.com/test"]]
# VITE_PROXY = [["/dev-api","http://192.168.9.66:48080/admin-api"]]
# VITE_PROXY = [["/api","http://192.168.9.66/yu-api"]]
# 本地启动需要配置的地址，修改http://192.168.9.66/yu-api 为前端nginx配置的页面显示地址
#通过nginx配置会进行接口转发，根据nginx配置会不同，目的是把/yu-api转入网关中
 VITE_PROXY = [["/yu-api","http://localhost:48080"]]

# 是否删除Console.log
VITE_DROP_CONSOLE = false

# 基础页面地址，例如 swagger 等页面
# VITE_GLOB_BASE_URL = "http://localhost:48080"
VITE_GLOB_BASE_URL = "http://localhost:3000/yu-api"

# 接口地址,如果没有跨域问题，直接在这里配置即可
# VITE_GLOB_API_URL = /dev-api
# 本地启动需要配置的地址
VITE_GLOB_API_URL = /yu-api/admin-api

# 上传地址
VITE_GLOB_UPLOAD_URL=/upload

# 接口地址前缀，有些系统所有接口地址都有前缀，可以在这里统一加，方便切换
VITE_GLOB_API_URL_PREFIX =

# 百度统计
VITE_APP_BAIDU_CODE = eb21166668bf766b9d059a6fd1c10777
